# Binary game and art assets go through Git LFS (git-lfs must be installed: `git lfs install`).
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
Contest/*.zip filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.ttf    filter=lfs diff=lfs merge=lfs -text
*.bin    filter=lfs diff=lfs merge=lfs -text

# Text everywhere else, with Unix line endings for the scripts.
*.sh  text eol=lf
*.py  text eol=lf
*.cs  text
*.cpp text
*.h   text
*.ini text

# The web build and marketing site are served by GitHub Pages, which cannot serve LFS objects.
# Keep everything under web/ and site/ as ordinary Git blobs.
web/** !filter !diff !merge
site/** !filter !diff !merge
